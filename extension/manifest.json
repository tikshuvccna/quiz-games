{
  "manifest_version": 3,
  "name": "פיצוץ מוחות · ייבוא מ־Kahoot",
  "short_name": "ייבוא מ־Kahoot",
  "description": "שומר חידונים של Kahoot כקובץ, או שולח אותם ישר לתוכנה פיצוץ מוחות, עם התמונות.",
  "version": "1.0.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "ייבוא חידונים מ־Kahoot", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://create.kahoot.it/*",
    "https://kahoot.it/*",
    "https://*.kahoot.it/*",
    "https://media.kahoot.it/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
